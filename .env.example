# Copy to .env and fill in your own values. Never commit the real .env.

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=Smart AI Employment Matching System

# --- Auth -----------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string

# --- AI providers ---------------------------------------------------------
# Primary: Google Gemini (free tier). Get a key at https://aistudio.google.com/apikey
# Leave GEMINI_API_KEY empty to run entirely on the offline deterministic engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated models tried in order when the primary is retired, overloaded
# or times out. Keep the list short: every entry is another attempt on the clock.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
# How long a single model attempt may take before the next one is tried.
GEMINI_TIMEOUT_MS=10000
# Ceiling for all attempts together. Keep it close to the attempt timeout: a
# silent model then costs one attempt, not one per model in the chain.
GEMINI_TOTAL_BUDGET_MS=10500
# false disables the online model everywhere, even with a key present.
LLM_ENABLED=true
# Jobs refined by one online call; the rest keep their deterministic score.
LLM_MAX_JOBS=12
# After a rate limit, timeout or outage, skip the online model for this long.
LLM_COOLDOWN_MS=60000
# Successful recommendation orderings are reused for this long.
LLM_CACHE_TTL_MS=300000
# Ceiling for one whole task, walking every tier before giving up. Wide enough
# for a Gemini timeout, a backup timeout and still one local attempt.
LLM_BUDGET_MS=32000
# Dashboard recommendations are a nicety, so their order gets a shorter leash
# than scoring. Keep it above GEMINI_TOTAL_BUDGET_MS: cutting a healthy model
# off mid-answer would put the whole tier into cooldown.
LLM_RANKING_BUDGET_MS=12000

# --- Tier 2: OpenAI-compatible backup --------------------------------------
# Used only when Gemini fails or is cooling down. Any provider that speaks the
# OpenAI chat-completions shape works: Groq, OpenRouter, Cerebras, Together.
#   Groq       https://api.groq.com/openai/v1
#   OpenRouter https://openrouter.ai/api/v1
# Leave BACKUP_LLM_API_KEY empty to skip this tier entirely.
BACKUP_LLM_ENABLED=true
BACKUP_LLM_API_KEY=
BACKUP_LLM_BASE_URL=https://api.groq.com/openai/v1
# Must be set, or the tier stays disabled: a retired model id should not be
# guessed from a stale default.
BACKUP_LLM_MODEL=
# Set false for gateways that reject response_format.
BACKUP_LLM_JSON_MODE=true
BACKUP_LLM_TIMEOUT_MS=5000

# --- Tier 3: embedded local model (node-llama-cpp) -------------------------
# Runs a .gguf file inside this Node process. No server, no extra install step
# beyond `npm install`. Empty path disables the tier.
# A 4B Q4_K_M model (about 2.5 GB) is the practical size for a CPU-only laptop.
# LOCAL_LLM_MODEL_PATH=C:\models\Qwen3-4B-Instruct-Q4_K_M.gguf
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODEL_PATH=
# Shown in the status endpoint and the UI badge.
LOCAL_LLM_MODEL=Local model
LOCAL_LLM_CONTEXT=8192
# 0 lets node-llama-cpp pick the thread count.
LOCAL_LLM_THREADS=0
# auto, max, or a layer count. auto uses whatever backend is available.
LOCAL_LLM_GPU_LAYERS=auto
LOCAL_LLM_TIMEOUT_MS=60000
# Below this much remaining budget a local attempt is skipped as pointless.
LOCAL_LLM_MIN_BUDGET_MS=12000
# Jobs refined by one local call: a CPU model cannot score a dozen in time.
LOCAL_LLM_MAX_JOBS=3
